{
  "name": "life-worksheet-library",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "html:worksheet": "node scripts/generate/worksheet-html.cjs",
    "html:check": "node scripts/generate/worksheet-html.cjs --check",
    "data": "node scripts/generate/catalog.cjs",
    "fonts": "node scripts/generate/fonts.cjs",
    "fonts:worksheet": "node scripts/generate/fonts.cjs --scope",
    "generate": "node scripts/generate/run.cjs",
    "check:static": "node scripts/check/static.cjs",
    "check:worksheet": "node scripts/check/worksheet.cjs",
    "check:worksheet:browser": "node scripts/check/worksheet-browser.cjs",
    "build": "node scripts/build/site.cjs",
    "check:browser": "node scripts/check/browser.cjs --built",
    "verify": "node scripts/check/run.cjs",
    "check": "pnpm run check:static",
    "test": "pnpm run verify"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
